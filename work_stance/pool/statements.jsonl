{"group": "G053", "statement": "A person should investigate the truth for themselves rather than blindly accept others' beliefs, while staying open to being wrong.", "kind": "advised", "thresholds": ["loose"], "books": ["buddha_dhamma", "c02", "vivekachudamani"], "entries": [["vivekachudamani", "t13"], ["buddha_dhamma", "t4"], ["buddha_dhamma", "t6"], ["c02", "m5"]]}
