{"group": "G061", "statement": "A person should loyally respect rulers, laws and elders, and those who rule should govern for the people's good.", "kind": "advised", "thresholds": ["loose"], "books": ["analects", "buddha_dhamma", "meditations", "ramcharitmanas", "republic", "vemana", "xiaojing"], "entries": [["analects", "t5"], ["analects", "t9"], ["analects", "t10"], ["meditations", "t24"], ["meditations", "t25"], ["republic", "t5"], ["republic", "t12"], ["republic", "t15"], ["xiaojing", "t5"], ["xiaojing", "t8"], ["xiaojing", "t18"], ["xiaojing", "t20"], ["xiaojing", "t21"], ["ramcharitmanas", "t14"], ["vemana", "t20"], ["buddha_dhamma", "t3"]]}
{"group": "G062", "statement": "A person should rely on the material world and their own powers instead of faith and prayer to the divine.", "kind": "criticized", "thresholds": ["tight"], "books": ["gita", "ramcharitmanas"], "entries": [["gita", "t7"], ["ramcharitmanas", "t6"], ["ramcharitmanas", "t8"]]}
