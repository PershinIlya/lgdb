{"group": "G004", "statement": "A person should keep their own death in mind and use that to focus on doing good in this life.", "kind": "advised", "thresholds": ["tight"], "books": ["analects", "c02", "vemana"], "entries": [["analects", "t26"], ["vemana", "t17"], ["c02", "m8"]]}
