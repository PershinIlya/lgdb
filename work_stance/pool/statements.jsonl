{"group": "G028", "statement": "A person should treat others as they wish to be treated, attending to their own just conduct rather than neighbors' actions.", "kind": "advised", "thresholds": ["tight"], "books": ["analects", "buddha_dhamma", "meditations"], "entries": [["analects", "t14"], ["meditations", "t16"], ["buddha_dhamma", "t23"]]}
