{"group": "G055", "statement": "A person should base their worth on others' recognition and on external things like fame and pleasure.", "kind": "criticized", "thresholds": ["tight"], "books": ["analects", "meditations"], "entries": [["analects", "t12"], ["analects", "t15"], ["analects", "t26"], ["meditations", "t2"], ["meditations", "t3"], ["meditations", "t8"]]}
