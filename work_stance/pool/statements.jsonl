{"group": "G015", "statement": "A person should perform traditional rites and honor ancestors, gods and parents with sincere reverence.", "kind": "advised", "thresholds": ["tight"], "books": ["analects", "buddha_dhamma", "ramcharitmanas", "vemana", "xiaojing"], "entries": [["analects", "t25"], ["xiaojing", "t4"], ["ramcharitmanas", "t13"], ["vemana", "t13"], ["buddha_dhamma", "t25"]]}
