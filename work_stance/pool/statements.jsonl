{"group": "G001", "statement": "A person should restrain lust, anger and sensual desire, and refuse to treat bodily pleasure as a good worth pursuing.", "kind": "advised", "thresholds": ["tight"], "books": ["gita", "meditations"], "entries": [["gita", "t4"], ["meditations", "t18"]]}
{"group": "G002", "statement": "A person in authority should lead by personal example for subjects' good, and a subordinate should serve rulers loyally while correcting their faults.", "kind": "advised", "thresholds": ["tight"], "books": ["analects", "ramcharitmanas", "republic", "vemana", "xiaojing"], "entries": [["analects", "t5"], ["analects", "t10"], ["republic", "t15"], ["xiaojing", "t5"], ["xiaojing", "t20"], ["ramcharitmanas", "t14"], ["vemana", "t20"]]}
