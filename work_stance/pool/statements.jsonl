{"group": "G026", "statement": "A person should openly admit and correct their own faults rather than hiding them or criticizing others.", "kind": "advised", "thresholds": ["tight"], "books": ["analects", "c06", "worldly_wisdom"], "entries": [["analects", "t13"], ["worldly_wisdom", "t7"], ["c06", "m7"]]}
